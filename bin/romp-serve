#!/usr/bin/env bash
# romp-serve — launches the romp web UI kernel for the manager (bin/romp-manager) to
# supervise. It is the seam between the manager's spawn contract and the kernel: the
# manager runs `romp-serve --port N` (with ROMP_SERVE_PORT / ROMP_MANAGER_PID in env)
# and supervises the resulting PID. We map those onto the Python kernel's env and
# `exec` it, so the manager keeps supervising the same PID and the kernel self-builds
# its UI bundles if stale.
#   romp-serve [--port N] [--host H]
# Host precedence: --host > local-only. The kernel stays bound to 127.0.0.1;
# tailnet/phone reach goes through `tailscale serve` proxying to loopback
# (docs/guide.md#from-your-phone), so there is no persisted off-loopback opt-in
# (`romp --serve` removed 2026-07-19). --host remains as the manager's spawn seam.
set -euo pipefail

# Resolve the repo root through any symlink (matches the other bin/ consumers).
src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
    tgt="$(readlink "$src")"
    case "$tgt" in
        /*) src="$tgt" ;;
        *)  src="$(cd "$(dirname "$src")" && pwd)/$tgt" ;;
    esac
done
# ROMP_SERVE_ROOT (the v1.3.17 audit's P1.2): an updater launches a SNAPSHOT copy of this
# script — the exec'd byte stream is the verified commit's, immune to a post-verify swap of the
# live file — and points it at the real checkout to serve. Everything below acts on ROMP_DIR,
# so the override is complete; without it the path-derived default is unchanged.
ROMP_DIR="${ROMP_SERVE_ROOT:-$(cd "$(dirname "$src")/.." && pwd)}"
# ROMP_KERNEL_BIN is the test seam (same pattern as ROMP_*_BIN elsewhere).
KERNEL="${ROMP_KERNEL_BIN:-$ROMP_DIR/bin/romp-kernel}"
# RUNTIME GENERATION, resolved AT SPAWN TIME (the v1.3.18 audit's P1, redesigned per the r46
# verification): when a durable per-commit generation (<gitdir>/romp-run-<sha8>, built by the
# update transactions) matches the checkout's CURRENT HEAD, its kernel — the verified commit's
# exact bytes, modules included — executes, with ROMP_CHECKOUT keeping every state/git/dist
# operation on the real checkout. No generation for HEAD (a local edit, a local update, a
# classic install) runs the checkout's own kernel, exactly as before. Per-spawn resolution
# replaced a per-manager-lifetime env pin, which froze every respawn on the pinning update's
# build: later LOCAL updates became silent no-ops running old bytes under a fresh sha.
# An explicit ROMP_KERNEL_BIN still wins (the seam above).
if [ -z "${ROMP_KERNEL_BIN:-}" ]; then
    _RGD="$(git -C "$ROMP_DIR" rev-parse --absolute-git-dir 2>/dev/null || true)"
    _RH8="$(git -C "$ROMP_DIR" rev-parse --short=8 HEAD 2>/dev/null || true)"
    if [ -n "$_RGD" ] && [ -n "$_RH8" ] && [ -x "$_RGD/romp-run-$_RH8/bin/romp-kernel" ]; then
        KERNEL="$_RGD/romp-run-$_RH8/bin/romp-kernel"
        export ROMP_CHECKOUT="$ROMP_DIR"
    fi
fi

# Port: the manager passes --port; fall back to the env, then the kernel default.
#
# ROMP_SERVE_PORT and ROMP_KERNEL_PORT are TWO SPELLINGS OF ONE VALUE: the port the kernel
# listens on. The split is historical and role-based, not semantic. ROMP_SERVE_PORT is the
# service-facing spelling (romp-manager, romp-service's unit, the wake hook, the VS Code
# extension); ROMP_KERNEL_PORT is the process-facing one (kernel.py, the postal bus, every
# `romp` CLI verb). This script is the seam between them, so it is where they have to agree.
#
# It used to read only ROMP_SERVE_PORT and then unconditionally OVERWRITE ROMP_KERNEL_PORT
# from it. Someone renumbering a second kernel by the documented knob alone (docs/reference.md
# names ROMP_KERNEL_PORT and not the other) got the two silently pulled apart: the unit carried
# no port, the manager fell back to the default, this script stamped that default over the
# inherited ROMP_KERNEL_PORT, and the second kernel bound the FIRST one's port while every
# foreground `romp` command went on printing the renumbered one. A collision that reports
# success is the exact shape the authoritative-sources rule exists to prevent, so now: accept
# either spelling, and if both are set and DISAGREE with no --port to settle it, refuse.
port=""
host=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --port) port="${2:-}"; shift 2 ;;
        --host) host="${2:-}"; shift 2 ;;
        *) shift ;;
    esac
done
if [[ -z "$port" ]]; then
    _sp="${ROMP_SERVE_PORT:-}"
    _kp="${ROMP_KERNEL_PORT:-}"
    if [[ -n "$_sp" && -n "$_kp" && "$_sp" != "$_kp" ]]; then
        echo "romp-serve: ROMP_SERVE_PORT=$_sp and ROMP_KERNEL_PORT=$_kp disagree." >&2
        echo "  They are two names for the kernel's listen port and must match. Set one, or pass --port." >&2
        exit 1
    fi
    port="${_sp:-$_kp}"
fi

# Host: explicit --host wins; else local-only. A leftover serve-host state file
# from the removed `romp --serve` opt-in is deliberately IGNORED — a stale file
# must never silently rebind the kernel off loopback.
host="${host:-127.0.0.1}"

[[ -x "$KERNEL" ]] || { echo "romp-serve: kernel not found/executable at $KERNEL" >&2; exit 1; }

# The kernel runs on the best python available, not blindly `python3`: the Agent SDK backend is
# imported INTO the kernel process and needs >= 3.10, while some hosts pin the system python3 older
# (Ubuntu 20.04 = 3.8) with a newer one alongside (e.g. a uv-managed 3.12 in ~/.local/bin — probed
# explicitly because a non-login ssh shell doesn't have it on PATH). ROMP_PYTHON overrides.
# KEEP IN SYNC with bin/romp-sdk-setup's pick_python — the SDK venv must be built with the SAME
# interpreter the kernel runs (its site-packages are added to the kernel's sys.path).
pick_python() {
    if [[ -n "${ROMP_PYTHON:-}" ]]; then echo "$ROMP_PYTHON"; return; fi
    local v c
    # Newest first. The list has to GROW with each release: a machine whose only python is newer than
    # everything named here falls through to `python3`, which is right when that IS the new one and wrong
    # when python3 points at something ancient. Seen on a 3.14-only box, 2026-07-28.
    for v in 3.14 3.13 3.12 3.11 3.10; do
        for c in "python$v" "$HOME/.local/bin/python$v"; do
            if command -v "$c" >/dev/null 2>&1; then command -v "$c"; return; fi
        done
    done
    command -v python3 || { echo "romp: no python3 on PATH" >&2; exit 1; }
}
PY="$(pick_python)"

# GATE ON THE INSTALL LATCH before the kernel ever execs (the user's audit, 2026-08-17: module
# imports and subsystems otherwise start on a half-installed checkout before any in-kernel heal
# can run). An armed latch naming THIS HEAD means the last update moved the code but install.sh
# never finished: heal it here and refuse to start the kernel unless install passes — the
# manager's backoff respawn is the retry. EVERY latch read, moot-check, and clear happens inside
# ONE flock-holding python (the adversarial review, 2026-08-17: the first cut moot-cleared and
# rm'd outside the lock, re-introducing at the shell level the erased-live-latch race the
# kernel's _boot_heal fix documents; and an unreadable HEAD must fail CLOSED, never read as
# "moot" — a git failure is not permission to erase the only recovery record). The lock fd rides
# into install.sh (pass_fds) so an orphaned installer keeps holding it.
# Exit 0 = clear to start; 70 = refuse (latched and unhealed, lock held elsewhere, HEAD unreadable).
if ! python3 - "$ROMP_DIR" <<'GATEPY'
import errno, fcntl, os, re, stat, subprocess, sys, time

root = sys.argv[1]
# INSIDE the install transaction (bootstrap's TXNPY runs install.sh, which starts the service,
# whose manager spawns THIS gate — all while TXNPY holds the update lock), waiting on the lock
# deadlocked the fresh install's dashboard-link poll against our own transaction (the adversarial
# review, 2026-08-18). The marker names the transaction's pid and counts only while it is alive,
# so a manager that outlives bootstrap cannot carry the bypass forward.
txn = os.environ.get("ROMP_INSIDE_UPDATE_TXN", "")
if txn.isdigit():
    try:
        os.kill(int(txn), 0)
        sys.exit(0)                    # the transaction owns the checkout; its verdict governs
    except OSError:
        pass                           # holder is gone: the marker is stale — gate normally
gd = subprocess.run(["git", "-C", root, "rev-parse", "--absolute-git-dir"],
                    capture_output=True, text=True)
gdir = (gd.stdout or "").strip()
if gd.returncode or not gdir:
    sys.exit(0)                        # not a git checkout: no latch can exist to gate on
# The LOCK comes FIRST, before any latch read: reading first let a kernel start in the window
# where an updater holds the lock but has not armed the latch yet — mid-update, HEAD about to
# move under the booting kernel's imports (the user's audit, 2026-08-18, reproduced directly).
# Bounded wait: a live install can legitimately hold this for a while; sibling kernels booting
# together contend for microseconds. Timing out still refuses (exit 70), never proceeds blind.
latch = os.path.join(gdir, "romp-install-failed")
def publish_line(full):
    """Publish the channel token riding ON the healed latch line ("sha8 channel") before the
    latch is spent — a healed build must wear the channel its update intended (the v1.3.8 audit
    reproduced THIS gate healing a crashed bootstrap's stable target and starting it under the
    stale dev marker, which then followed unsigned main). The channel lives IN the line: every
    separate-file design failed twice (orphans published by strangers, carried records dropped —
    the adversarial reviews, 2026-08-20). True when the line stages no channel."""
    toks = full.split()
    if len(toks) < 2 or toks[1] not in ("stable", "dev"):
        return True
    mk = os.path.join(gdir, "romp-update-channel")
    try:
        try:
            os.unlink(mk + ".pub")     # a planted FIFO at the FIXED staging name blocked this
        except FileNotFoundError:      # open() while the gate HELD the update flock (the r32
            pass                       # verification, executed)
        with open(mk + ".pub", "w") as pf:
            pf.write(toks[1] + "\n")
        os.replace(mk + ".pub", mk)
        return True
    except OSError:
        return False
try:
    fd = os.open(os.path.join(gdir, "romp-update.lock"), os.O_RDWR | os.O_CREAT, 0o644)
except OSError:
    # can't even open the lock (read-only/unowned git dir): with NO latch there is nothing to
    # gate — such a checkout can't host updates either; with one, protect it (fail closed)
    sys.exit(70 if os.path.exists(latch) else 0)
deadline = time.time() + float(os.environ.get("ROMP_GATE_LOCK_WAIT", "90"))
while True:
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        break
    except OSError:
        if time.time() >= deadline:
            sys.exit(70)               # an update/heal is still running: do not start on it
        time.sleep(0.5)
# UNDER the lock: read, moot-check, heal, clear. The latch may carry TWO lines — the intent and
# the PRIOR record it superseded (a heal that keeps failing no longer blocks updates; the new arm
# carries the old sha instead — the adversarial review, 2026-08-19): heal whichever line HEAD
# matches; a prior present with HEAD matching nothing is an update that died mid-move from a
# broken state — fail closed, never moot.
try:
    if not stat.S_ISREG(os.stat(latch).st_mode):
        sys.exit(70)                   # a FIFO/device blocks open() forever — unknown, refuse
    rawlines = [ln.strip() for ln in open(latch).read().splitlines() if ln.strip()]
except FileNotFoundError:
    sys.exit(0)                        # no latch: clear to start
except (OSError, ValueError):
    sys.exit(70)                       # an EXISTING latch we cannot read — or DECODE: non-UTF-8
#                                        used to die as a raw traceback instead of this designed
#                                        refusal (the r30 verification) — is unknown, not absent
# STRICT GRAMMAR (the v1.3.9 audit): 1-2 lines of "sha8" / "sha8 stable|dev", or the exact
# quarantine form — anything ELSE that exists (an empty file this gate used to DELETE and then
# serve, a torn "quarantin", a malformed "sha8 sta") is unknown: refuse, never moot.
if not rawlines:
    sys.stderr.write("romp-serve: the install latch exists but is EMPTY — an unknown record is "
                     "never absent; heal by hand\n")
    sys.exit(70)
if rawlines != ["quarantined", "quarantined"] and (
        len(rawlines) > 2
        or any(not re.fullmatch(r"[0-9a-f]{8}( (stable|dev))?", ln) for ln in rawlines)):
    sys.stderr.write("romp-serve: the install latch holds %r, which is not a valid record — "
                     "corrupt or foreign state is never moot; heal by hand\n" % rawlines[:2])
    sys.exit(70)
lines = [ln.split()[0][:8] for ln in rawlines]
cur = subprocess.run(["git", "-C", root, "rev-parse", "--short=8", "HEAD"],
                     capture_output=True, text=True)
cur8 = (cur.stdout or "").strip()[:8]
if cur.returncode or not cur8:
    sys.exit(70)                       # unreadable HEAD: fail CLOSED, never "moot"
if cur8 not in lines:
    if len(lines) > 1:
        sys.stderr.write("romp-serve: the install latch names %s and prior %s but HEAD is %s — "
                         "heal by hand (run install.sh, then remove the latch)\n"
                         % (lines[0], lines[1], cur8))
        sys.exit(70)
    if len(lines[0]) != 8 or any(c not in "0123456789abcdef" for c in lines[0]):
        sys.stderr.write("romp-serve: the install latch holds %r, which is not a commit — a "
                         "corrupt or foreign record is never moot; heal by hand\n" % lines[0])
        sys.exit(70)                   # fail closed (the v1.3.8 audit: a torn quarantine prefix
        #                                parsed as one line and was moot-removed into serving)
    os.remove(latch)                   # intent-only mismatch: the move never landed — moot,
    sys.exit(0)                        # and the line's channel token dies with it
import shutil as _sh
def snap_install(commit):
    # the SNAPSHOT installer (the v1.3.16 audit's P1.1; the r44 verification extended it to
    # every leg): the COMMIT's complete tree executes — never live-tree bytes a racing writer
    # could swap mid-install; ROMP_INSTALL_TARGET aims outputs at the real checkout
    _snap = os.path.join(gdir, "romp-install-snap")
    _sh.rmtree(_snap, ignore_errors=True)
    os.makedirs(_snap)
    _a = subprocess.run(["git", "-C", root, "archive", commit], capture_output=True)
    if _a.returncode or not _a.stdout:
        return False
    if subprocess.run(["tar", "-x", "-C", _snap], input=_a.stdout).returncode \
            or not os.path.exists(os.path.join(_snap, "install.sh")):
        _sh.rmtree(_snap, ignore_errors=True)
        return False
    _env = dict(os.environ, ROMP_INSTALL_TARGET=root)
    _rc = subprocess.run(["bash", os.path.join(_snap, "install.sh")], cwd=root, env=_env,
                         pass_fds=(fd,)).returncode
    _sh.rmtree(_snap, ignore_errors=True)
    return _rc == 0
sys.stderr.write("romp-serve: this checkout's last install never finished — running install.sh before the kernel starts\n")
if not snap_install(cur8):
    sys.exit(70)                       # latch stays armed for the next retry
cur_line = next(ln for ln in rawlines if ln.split()[0][:8] == cur8)
if len(cur_line.split()) < 2 and cur_line == rawlines[0] and len(rawlines) > 1 \
        and len(rawlines[1].split()) > 1:
    cur_line = rawlines[1]             # the completing INTENT line inherits the carried choice —
    #                                    but never the reverse (the v1.3.11 audit: this gate
    #                                    erased a carried stable and served under dev)
if not publish_line(cur_line):
    sys.stderr.write("romp-serve: healed the install but its update channel could not be "
                     "recorded — not starting this build under the OLD channel marker\n")
    sys.exit(70)                       # latch stays armed; the next retry publishes
os.remove(latch)                       # healed — spent under the same lock
sys.exit(0)
GATEPY
then
    echo "romp-serve: install.sh did not pass (or another update holds this checkout's lock, or HEAD is unreadable) --" >&2
    echo "  refusing to start a kernel on a half-installed build; the manager retries with backoff." >&2
    exit 70
fi

# Map onto the kernel's env, then exec it (preserving the PID for the manager).
# ROMP_MANAGER_PID (parent-death watchdog) and ROMP_SERVE_TOKEN (auto-loaded from the
# persisted token file if unset) flow through untouched. ROMP_KERNEL_NO_OPEN keeps a
# supervised kernel from popping a browser on every (re)spawn.
export ROMP_DIR
export ROMP_BIN="${ROMP_BIN:-$ROMP_DIR/bin/romp}"
# Export BOTH spellings from the ONE resolved port, so nothing downstream can read a stale
# inherited copy of the other name: the kernel and the postal bus read ROMP_KERNEL_PORT, while
# the wake hook and any `romp` CLI run inside a session of this kernel may read either. Unset
# stays unset (the kernel applies its own default), so a bare launch is unchanged.
if [[ -n "$port" ]]; then
    export ROMP_KERNEL_PORT="$port"
    export ROMP_SERVE_PORT="$port"
fi
export ROMP_SERVE_HOST="$host"
export ROMP_KERNEL_NO_OPEN=1
exec "$PY" "$KERNEL"
