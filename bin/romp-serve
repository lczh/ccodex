#!/usr/bin/env bash
# romp-serve — launches the romp web UI kernel for the manager (bin/romp-manager) to
# supervise. It is the seam between the manager's spawn contract and the kernel: the
# manager runs `romp-serve --port N` (with ROMP_SERVE_PORT / ROMP_MANAGER_PID in env)
# and supervises the resulting PID. We map those onto the Python kernel's env and
# `exec` it, so the manager keeps supervising the same PID and the kernel self-builds
# its UI bundles if stale.
#   romp-serve [--port N] [--host H]
# Host precedence: --host > local-only. The kernel stays bound to 127.0.0.1;
# tailnet/phone reach goes through `tailscale serve` proxying to loopback
# (docs/guide.md#from-your-phone), so there is no persisted off-loopback opt-in
# (`romp --serve` removed 2026-07-19). --host remains as the manager's spawn seam.
set -euo pipefail

# Resolve the repo root through any symlink (matches the other bin/ consumers).
src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
    tgt="$(readlink "$src")"
    case "$tgt" in
        /*) src="$tgt" ;;
        *)  src="$(cd "$(dirname "$src")" && pwd)/$tgt" ;;
    esac
done
# ROMP_SERVE_ROOT (the v1.3.17 audit's P1.2): an updater launches a SNAPSHOT copy of this
# script — the exec'd byte stream is the verified commit's, immune to a post-verify swap of the
# live file — and points it at the real checkout to serve. Everything below acts on ROMP_DIR,
# so the override is complete; without it the path-derived default is unchanged.
ROMP_DIR="${ROMP_SERVE_ROOT:-$(cd "$(dirname "$src")/.." && pwd)}"
# ROMP_KERNEL_BIN is the test seam (same pattern as ROMP_*_BIN elsewhere).
KERNEL="${ROMP_KERNEL_BIN:-$ROMP_DIR/bin/romp-kernel}"
# RUNTIME GENERATION, resolved AT SPAWN TIME (the v1.3.18 audit's P1, redesigned per the r46
# verification): when a durable per-commit generation (<gitdir>/romp-run-<sha8>, built by the
# update transactions) matches the checkout's CURRENT HEAD, its kernel — the verified commit's
# exact bytes, modules included — executes, with ROMP_CHECKOUT keeping every state/git/dist
# operation on the real checkout. No generation for HEAD (a local edit, a local update, a
# classic install) runs the checkout's own kernel, exactly as before. Per-spawn resolution
# replaced a per-manager-lifetime env pin, which froze every respawn on the pinning update's
# build: later LOCAL updates became silent no-ops running old bytes under a fresh sha.
# An explicit ROMP_KERNEL_BIN still wins (the seam above).
# a STALE PIN into a pruned generation self-heals here (the r46 re-verify: managers spawned by
# the v1.3.18 env-pin wrapper carry ROMP_KERNEL_BIN for life, and once the pinned generation is
# pruned that seam made every respawn exit 1 forever — a permanent crash loop). Only pins INTO
# a romp-run-* dir are second-guessed; an explicit test/dev seam to any other path still wins
# unconditionally.
case "${ROMP_KERNEL_BIN:-}" in
    *romp-run-*) [ -x "$ROMP_KERNEL_BIN" ] || unset ROMP_KERNEL_BIN ;;
esac
# recomputed AFTER the unset (the r46 coverage pass: KERNEL was assigned from the pin BEFORE
# the case above, so a stale pin with no generation for the current HEAD still exited 1 at the
# pruned path — the exact crash loop the self-heal exists for)
KERNEL="${ROMP_KERNEL_BIN:-$ROMP_DIR/bin/romp-kernel}"
# The AUTHORITATIVE launch pick happens INSIDE the gate below, under the checkout's update
# lock (the v1.3.21 audit's P1.2): resolving a generation HERE raced the gate's own lock wait —
# an updater landing during those (up to 90) seconds moved HEAD and the marker to B while this
# shell had already picked A, and the boot launched A as if it were the update. The gate writes
# its pick ("gen <dir>" | "live") to the ROMP_GATE_PICK file; bash applies it after the gate
# returns. Only the explicit ROMP_KERNEL_BIN seam (and a non-git checkout, where the gate exits
# before picking) keeps the default computed here. The live default never inherits a stale
# ROMP_CHECKOUT (the r46 re-verify: a leaked value made _kernel_sha attribute live bytes to a
# generation name); the gen pick re-exports it below.
unset ROMP_CHECKOUT
_ROMP_PICK="$(mktemp "${TMPDIR:-/tmp}/romp-serve-pick.XXXXXX" 2>/dev/null || true)"
if [ -n "$_ROMP_PICK" ]; then
    export ROMP_GATE_PICK="$_ROMP_PICK"
    # every REFUSED boot leaked its pick file (the r50 verification: three refusals, three
    # files) — the trap covers every exit; the exec path removes it explicitly first
    trap '[ -n "${_ROMP_PICK:-}" ] && rm -f "$_ROMP_PICK"' EXIT
elif git -C "$ROMP_DIR" rev-parse --absolute-git-dir >/dev/null 2>&1; then
    # NO pick channel on a GIT checkout fails CLOSED (the v1.3.23 audit's P1.2): with the pick
    # file unmintable (an invalid TMPDIR), the gate could only refuse non-live picks — a gate
    # that picked "live" exited 0 with nothing to deliver, and bash then skipped the whole
    # strict applier AND the exec revalidation, so an update landing after the gate armed its
    # marker still saw unverified mutable live bytes execute. The pick channel is the strict
    # path's spine; a git checkout that cannot create it does not boot. A non-git checkout
    # keeps booting: it hosts no updates, so there is no pick to protect.
    echo "romp-serve: cannot create the launch-pick channel under ${TMPDIR:-/tmp} — refusing" >&2
    echo "  to boot without the strict launch pick (fix TMPDIR; the manager retries)." >&2
    exit 70
fi

# Port: the manager passes --port; fall back to the env, then the kernel default.
#
# ROMP_SERVE_PORT and ROMP_KERNEL_PORT are TWO SPELLINGS OF ONE VALUE: the port the kernel
# listens on. The split is historical and role-based, not semantic. ROMP_SERVE_PORT is the
# service-facing spelling (romp-manager, romp-service's unit, the wake hook, the VS Code
# extension); ROMP_KERNEL_PORT is the process-facing one (kernel.py, the postal bus, every
# `romp` CLI verb). This script is the seam between them, so it is where they have to agree.
#
# It used to read only ROMP_SERVE_PORT and then unconditionally OVERWRITE ROMP_KERNEL_PORT
# from it. Someone renumbering a second kernel by the documented knob alone (docs/reference.md
# names ROMP_KERNEL_PORT and not the other) got the two silently pulled apart: the unit carried
# no port, the manager fell back to the default, this script stamped that default over the
# inherited ROMP_KERNEL_PORT, and the second kernel bound the FIRST one's port while every
# foreground `romp` command went on printing the renumbered one. A collision that reports
# success is the exact shape the authoritative-sources rule exists to prevent, so now: accept
# either spelling, and if both are set and DISAGREE with no --port to settle it, refuse.
port=""
host=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --port) port="${2:-}"; shift 2 ;;
        --host) host="${2:-}"; shift 2 ;;
        *) shift ;;
    esac
done
if [[ -z "$port" ]]; then
    _sp="${ROMP_SERVE_PORT:-}"
    _kp="${ROMP_KERNEL_PORT:-}"
    if [[ -n "$_sp" && -n "$_kp" && "$_sp" != "$_kp" ]]; then
        echo "romp-serve: ROMP_SERVE_PORT=$_sp and ROMP_KERNEL_PORT=$_kp disagree." >&2
        echo "  They are two names for the kernel's listen port and must match. Set one, or pass --port." >&2
        exit 1
    fi
    port="${_sp:-$_kp}"
fi

# Host: explicit --host wins; else local-only. A leftover serve-host state file
# from the removed `romp --serve` opt-in is deliberately IGNORED — a stale file
# must never silently rebind the kernel off loopback.
host="${host:-127.0.0.1}"

# The early executability check applies only to the EXPLICIT seam: the authoritative pick
# (gen or live) is the gate's, made under the lock and applied just before exec below.
if [ -n "${ROMP_KERNEL_BIN:-}" ]; then
    [[ -x "$KERNEL" ]] || { echo "romp-serve: kernel not found/executable at $KERNEL" >&2; exit 1; }
fi

# The kernel runs on the best python available, not blindly `python3`: the Agent SDK backend is
# imported INTO the kernel process and needs >= 3.10, while some hosts pin the system python3 older
# (Ubuntu 20.04 = 3.8) with a newer one alongside (e.g. a uv-managed 3.12 in ~/.local/bin — probed
# explicitly because a non-login ssh shell doesn't have it on PATH). ROMP_PYTHON overrides.
# KEEP IN SYNC with bin/romp-sdk-setup's pick_python — the SDK venv must be built with the SAME
# interpreter the kernel runs (its site-packages are added to the kernel's sys.path).
pick_python() {
    if [[ -n "${ROMP_PYTHON:-}" ]]; then echo "$ROMP_PYTHON"; return; fi
    local v c
    # Newest first. The list has to GROW with each release: a machine whose only python is newer than
    # everything named here falls through to `python3`, which is right when that IS the new one and wrong
    # when python3 points at something ancient. Seen on a 3.14-only box, 2026-07-28.
    for v in 3.14 3.13 3.12 3.11 3.10; do
        for c in "python$v" "$HOME/.local/bin/python$v"; do
            if command -v "$c" >/dev/null 2>&1; then command -v "$c"; return; fi
        done
    done
    command -v python3 || { echo "romp: no python3 on PATH" >&2; exit 1; }
}
PY="$(pick_python)"

# GATE ON THE INSTALL LATCH before the kernel ever execs (the user's audit, 2026-08-17: module
# imports and subsystems otherwise start on a half-installed checkout before any in-kernel heal
# can run). An armed latch naming THIS HEAD means the last update moved the code but install.sh
# never finished: heal it here and refuse to start the kernel unless install passes — the
# manager's backoff respawn is the retry. EVERY latch read, moot-check, and clear happens inside
# ONE flock-holding python (the adversarial review, 2026-08-17: the first cut moot-cleared and
# rm'd outside the lock, re-introducing at the shell level the erased-live-latch race the
# kernel's _boot_heal fix documents; and an unreadable HEAD must fail CLOSED, never read as
# "moot" — a git failure is not permission to erase the only recovery record). The lock fd rides
# into install.sh (pass_fds) so an orphaned installer keeps holding it.
# Exit 0 = clear to start; 70 = refuse (latched and unhealed, lock held elsewhere, HEAD unreadable).
if ! python3 - "$ROMP_DIR" <<'GATEPY'
import errno, fcntl, os, re, stat, subprocess, sys, time

root = sys.argv[1]
# INSIDE the install transaction (bootstrap's TXNPY runs install.sh, which starts the service,
# whose manager spawns THIS gate — all while TXNPY holds the update lock), waiting on the lock
# deadlocked the fresh install's dashboard-link poll against our own transaction (the adversarial
# review, 2026-08-18). The marker names the transaction's pid and counts only while it is alive,
# so a manager that outlives bootstrap cannot carry the bypass forward.
gd = subprocess.run(["git", "-C", root, "rev-parse", "--absolute-git-dir"],
                    capture_output=True, text=True)
gdir = (gd.stdout or "").strip()
if gd.returncode or not gdir:
    _pf0 = os.environ.get("ROMP_GATE_PICK") or ""
    if _pf0:
        try:
            with open(_pf0, "w") as _pfh0:
                _pfh0.write("live\n")     # every exit-0 delivers a pick (the r50 verification:
        except OSError:                    # bash hard-requires one now — absence is tampering
            pass                           # or failure, never a live default)
    sys.exit(0)                        # not a git checkout: no latch can exist to gate on
mkp = os.path.join(gdir, "romp-restart-needed")
import shutil as _sh
def gen_valid(g, full):
    # VALIDATED bless (the v1.3.20 audit's P2): an existing directory counts only with a
    # matching .romp-gen manifest and executable kernel + serve — an empty or torn generation
    # used to be blessed by its bare existence and then exec'd forever. Stat-gated,
    # nonblocking, no-follow (the v1.3.21 audit's P1.4): a FIFO planted at the manifest name
    # hung the blocking open() forever, UNDER the update lock.
    mfp = os.path.join(g, ".romp-gen")
    try:
        if not stat.S_ISREG(os.lstat(mfp).st_mode):
            return False
        mfd = os.open(mfp, os.O_RDONLY | getattr(os, "O_NONBLOCK", 0)
                      | getattr(os, "O_NOFOLLOW", 0))
        try:
            mf = os.read(mfd, 4096).decode(errors="replace").strip()
        finally:
            os.close(mfd)
    except OSError:
        return False
    return (mf == full and os.access(os.path.join(g, "bin", "romp-kernel"), os.X_OK)
            and os.access(os.path.join(g, "bin", "romp-serve"), os.X_OK))
def gen_build(commit):
    # content-checked; published by os.rename, which FAILS on an existing target so a
    # concurrent builder's win is validated-blessed instead of `mv` nesting into it (r47)
    rv = subprocess.run(["git", "-C", root, "rev-parse", commit], capture_output=True, text=True)
    full = (rv.stdout or "").strip()
    if rv.returncode or len(full) < 8:
        return False
    g = os.path.join(gdir, "romp-run-" + full[:8])
    if os.path.isdir(g):
        if gen_valid(g, full):
            return True
        _sh.rmtree(g, ignore_errors=True)      # never bless a torn generation — rebuild it
    gt = g + ".tmp.%d" % os.getpid()
    _sh.rmtree(gt, ignore_errors=True)
    _a = subprocess.run(["git", "-C", root, "archive", full], capture_output=True)
    if _a.returncode or not _a.stdout:
        return False
    os.makedirs(gt)
    _t = subprocess.run(["tar", "-x", "-C", gt], input=_a.stdout)
    try:
        with open(os.path.join(gt, ".romp-gen"), "w") as _mh:
            _mh.write(full + "\n")
    except OSError:
        _sh.rmtree(gt, ignore_errors=True)
        return False
    if _t.returncode or not os.access(os.path.join(gt, "bin", "romp-kernel"), os.X_OK) \
            or not os.access(os.path.join(gt, "bin", "romp-serve"), os.X_OK):
        _sh.rmtree(gt, ignore_errors=True)
        return False
    try:
        os.rename(gt, g)
    except OSError:
        _sh.rmtree(gt, ignore_errors=True)
        return gen_valid(g, full)
    return True
def arm_marker(commit):
    # every latch-spending path arms the update marker BEFORE the spend (the r48 verification:
    # this gate's heal was the one leg that spent without arming — the healed signed release
    # then exec'd mutated live bytes on a dirty tree, the exact audited P1.2, with all
    # indicators green)
    rv = subprocess.run(["git", "-C", root, "rev-parse", commit], capture_output=True, text=True)
    full = (rv.stdout or "").strip()
    if rv.returncode or len(full) < 8:
        return False
    tmpm = os.path.join(gdir, "romp-restart-needed.tmp.%d" % os.getpid())
    try:
        with open(tmpm, "w") as _mf:
            _mf.write(full + "\n")
        os.replace(tmpm, os.path.join(gdir, "romp-restart-needed"))
        return True
    except OSError:
        try:
            os.unlink(tmpm)
        except OSError:
            pass
        return False
def emit_pick():
    # the AUTHORITATIVE launch pick, made UNDER the update lock (the v1.3.21 audit's P1.2):
    # bash used to pick a generation BEFORE the gate even waited for the lock — an updater
    # landing during that wait moved HEAD and the marker to B while the shell launched A.
    # Every success exit of this gate passes through here; bash reads the pick file after
    # the gate returns and launches exactly what was chosen under the lock.
    pf = os.environ.get("ROMP_GATE_PICK") or ""
    choice = "live"
    hf = subprocess.run(["git", "-C", root, "rev-parse", "HEAD"], capture_output=True, text=True)
    full = (hf.stdout or "").strip()
    mtok2 = ""
    try:
        if stat.S_ISREG(os.lstat(mkp).st_mode):
            mfd = os.open(mkp, os.O_RDONLY | getattr(os, "O_NONBLOCK", 0)
                          | getattr(os, "O_NOFOLLOW", 0))
            try:
                mtok2 = (os.read(mfd, 4096).decode(errors="replace").split() or [""])[0]
            finally:
                os.close(mfd)
    except FileNotFoundError:
        mtok2 = ""
    except OSError:
        sys.exit(70)
    if hf.returncode == 0 and len(full) >= 8:
        g = os.path.join(gdir, "romp-run-" + full[:8])
        ds = subprocess.run(["git", "-C", root, "status", "--porcelain"],
                            capture_output=True, text=True)
        is_dirty = bool(ds.returncode) or bool((ds.stdout or "")[:1])
        mk_match = bool(mtok2) and (full.startswith(mtok2) or mtok2.startswith(full[:8]))
        if (mk_match or not is_dirty) and gen_valid(g, full):
            choice = "gen " + g
        if mk_match and choice == "live":
            sys.stderr.write("romp-serve: the update marker names HEAD but no verified "
                             "generation exists at pick time — refusing live bytes\n")
            sys.exit(70)
        if mk_match and is_dirty:
            sys.stderr.write("romp-serve: an update to %s just landed — launching its VERIFIED "
                             "build; tracked edits in the checkout are ignored for this boot and "
                             "run normally from the next spawn (the marker clears once the "
                             "updated kernel is up)\n" % full[:8])
    elif mtok2:
        sys.exit(70)                   # armed marker + unreadable HEAD: never live (P1.1/P1.2)
    if choice != "live" and not pf:
        # FAIL CLOSED (the r49 verification): with no deliverable pick, bash keeps its live
        # default — a marker-forced generation pick silently becoming a dirty live launch is
        # the audited P1.2 wearing a success log line. A live choice needs no delivery.
        sys.stderr.write("romp-serve: the launch pick cannot be delivered (no pick file) — "
                         "refusing to fall back to live bytes\n")
        sys.exit(70)
    if pf:
        try:
            with open(pf, "w") as pfh:
                pfh.write(choice + "\n")
        except OSError:
            if choice != "live":
                sys.stderr.write("romp-serve: the launch pick could not be written — refusing "
                                 "to fall back to live bytes\n")
                sys.exit(70)
txn = os.environ.get("ROMP_INSIDE_UPDATE_TXN", "")
if txn.isdigit():
    try:
        os.kill(int(txn), 0)
        # the transaction owns the checkout; its verdict governs — but the LAUNCH pick still
        # happens (locklessly: the txn holds the lock, and these are advisory reads), or this
        # exit regressed marker-honoring spawns to blind live bytes (the r49 verification)
        emit_pick()
        sys.exit(0)
    except OSError:
        pass                           # holder is gone: the marker is stale — gate normally
# The LOCK comes FIRST, before any latch read: reading first let a kernel start in the window
# where an updater holds the lock but has not armed the latch yet — mid-update, HEAD about to
# move under the booting kernel's imports (the user's audit, 2026-08-18, reproduced directly).
# Bounded wait: a live install can legitimately hold this for a while; sibling kernels booting
# together contend for microseconds. Timing out still refuses (exit 70), never proceeds blind.
latch = os.path.join(gdir, "romp-install-failed")
def publish_line(full):
    """Publish the channel token riding ON the healed latch line ("sha8 channel") before the
    latch is spent — a healed build must wear the channel its update intended (the v1.3.8 audit
    reproduced THIS gate healing a crashed bootstrap's stable target and starting it under the
    stale dev marker, which then followed unsigned main). The channel lives IN the line: every
    separate-file design failed twice (orphans published by strangers, carried records dropped —
    the adversarial reviews, 2026-08-20). True when the line stages no channel."""
    toks = full.split()
    if len(toks) < 2 or toks[1] not in ("stable", "dev"):
        return True
    mk = os.path.join(gdir, "romp-update-channel")
    try:
        try:
            os.unlink(mk + ".pub")     # a planted FIFO at the FIXED staging name blocked this
        except FileNotFoundError:      # open() while the gate HELD the update flock (the r32
            pass                       # verification, executed)
        with open(mk + ".pub", "w") as pf:
            pf.write(toks[1] + "\n")
        os.replace(mk + ".pub", mk)
        return True
    except OSError:
        return False
try:
    fd = os.open(os.path.join(gdir, "romp-update.lock"), os.O_RDWR | os.O_CREAT, 0o644)
except OSError:
    # can't even open the lock (read-only/unowned git dir): with NO latch there is nothing to
    # gate — such a checkout can't host updates either; with one, protect it (fail closed)
    if os.path.exists(latch):
        sys.exit(70)
    emit_pick()                        # lockless: an unowned/read-only git dir hosts no updates,
    sys.exit(0)                        # so the advisory reads are stable (the r49 verification)
deadline = time.time() + float(os.environ.get("ROMP_GATE_LOCK_WAIT", "90"))
while True:
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        break
    except OSError:
        if time.time() >= deadline:
            sys.exit(70)               # an update/heal is still running: do not start on it
        time.sleep(0.5)
# the UPDATE MARKER leg (the v1.3.20 audit's P1.2), under the same lock and BEFORE the
# latch's no-latch early exit: while romp-restart-needed names HEAD, this boot must run the
# verified generation — ensure it exists (validated bless or build) or refuse to start.
# This also backfills the N−1 upgrade path: an old updater that spent the latch without
# building a generation leaves the marker, and the first spawn builds it here (the same
# audit's P1.1 belt alongside install.sh's own build).
try:
    import stat as _stat
    if not _stat.S_ISREG(os.lstat(mkp).st_mode):
        sys.stderr.write("romp-serve: romp-restart-needed exists but is not a regular file — "
                         "foreign state; heal by hand\n")
        sys.exit(70)
    mtok = (open(mkp).read().split() or [""])[0]
    if not mtok:
        # an EXISTING but EMPTY marker is unknown state, never absence (the v1.3.21 audit's
        # P1.1: a torn arm read as no-marker and the boot took the dirty-live leg under the
        # very intent record that forbids it)
        sys.stderr.write("romp-serve: romp-restart-needed exists but is EMPTY — an unknown "
                         "record is never absent; heal by hand\n")
        sys.exit(70)
except FileNotFoundError:
    mtok = ""
except (OSError, ValueError):
    sys.exit(70)                       # an EXISTING marker we cannot read is unknown, not absent
if mtok:
    if not re.fullmatch(r"[0-9a-f]{7,40}", mtok):
        sys.stderr.write("romp-serve: romp-restart-needed holds %r, which is not a commit — "
                         "corrupt or foreign state; heal by hand\n" % mtok[:48])
        sys.exit(70)
    _hf = subprocess.run(["git", "-C", root, "rev-parse", "HEAD"], capture_output=True, text=True)
    _hfull = (_hf.stdout or "").strip()
    if _hf.returncode or not _hfull:
        # an ARMED marker with an unreadable HEAD is unknown, never moot: proceeding took the
        # live-byte leg under the very marker that forbids it (the r48 verification — this leg
        # failed OPEN)
        sys.stderr.write("romp-serve: romp-restart-needed is armed but HEAD is unreadable — "
                         "refusing to start on unknown state\n")
        sys.exit(70)
    if _hfull.startswith(mtok) or mtok.startswith(_hfull[:8]):
        if not gen_build(_hfull):
            sys.stderr.write("romp-serve: an update to %s landed but its verified build cannot "
                             "be produced — refusing to start live bytes under the update "
                             "marker (the v1.3.20 audit's P1.2)\n" % _hfull[:8])
            sys.exit(70)
    # HEAD elsewhere: the marker stays — the running-kernel drift banner is that surface
# UNDER the lock: read, moot-check, heal, clear. The latch may carry TWO lines — the intent and
# the PRIOR record it superseded (a heal that keeps failing no longer blocks updates; the new arm
# carries the old sha instead — the adversarial review, 2026-08-19): heal whichever line HEAD
# matches; a prior present with HEAD matching nothing is an update that died mid-move from a
# broken state — fail closed, never moot.
try:
    if not stat.S_ISREG(os.stat(latch).st_mode):
        sys.exit(70)                   # a FIFO/device blocks open() forever — unknown, refuse
    rawlines = [ln.strip() for ln in open(latch).read().splitlines() if ln.strip()]
except FileNotFoundError:
    emit_pick()
    sys.exit(0)                        # no latch: clear to start
except (OSError, ValueError):
    sys.exit(70)                       # an EXISTING latch we cannot read — or DECODE: non-UTF-8
#                                        used to die as a raw traceback instead of this designed
#                                        refusal (the r30 verification) — is unknown, not absent
# STRICT GRAMMAR (the v1.3.9 audit): 1-2 lines of "sha8" / "sha8 stable|dev", or the exact
# quarantine form — anything ELSE that exists (an empty file this gate used to DELETE and then
# serve, a torn "quarantin", a malformed "sha8 sta") is unknown: refuse, never moot.
if not rawlines:
    sys.stderr.write("romp-serve: the install latch exists but is EMPTY — an unknown record is "
                     "never absent; heal by hand\n")
    sys.exit(70)
if rawlines != ["quarantined", "quarantined"] and (
        len(rawlines) > 2
        or any(not re.fullmatch(r"[0-9a-f]{8}( (stable|dev))?", ln) for ln in rawlines)):
    sys.stderr.write("romp-serve: the install latch holds %r, which is not a valid record — "
                     "corrupt or foreign state is never moot; heal by hand\n" % rawlines[:2])
    sys.exit(70)
lines = [ln.split()[0][:8] for ln in rawlines]
cur = subprocess.run(["git", "-C", root, "rev-parse", "--short=8", "HEAD"],
                     capture_output=True, text=True)
cur8 = (cur.stdout or "").strip()[:8]
if cur.returncode or not cur8:
    sys.exit(70)                       # unreadable HEAD: fail CLOSED, never "moot"
if cur8 not in lines:
    if len(lines) > 1:
        sys.stderr.write("romp-serve: the install latch names %s and prior %s but HEAD is %s — "
                         "heal by hand (run install.sh, then remove the latch)\n"
                         % (lines[0], lines[1], cur8))
        sys.exit(70)
    if len(lines[0]) != 8 or any(c not in "0123456789abcdef" for c in lines[0]):
        sys.stderr.write("romp-serve: the install latch holds %r, which is not a commit — a "
                         "corrupt or foreign record is never moot; heal by hand\n" % lines[0])
        sys.exit(70)                   # fail closed (the v1.3.8 audit: a torn quarantine prefix
        #                                parsed as one line and was moot-removed into serving)
    os.remove(latch)                   # intent-only mismatch: the move never landed — moot,
    emit_pick()
    sys.exit(0)                        # and the line's channel token dies with it
def snap_install(commit):
    # the SNAPSHOT installer (the v1.3.16 audit's P1.1; the r44 verification extended it to
    # every leg): the COMMIT's complete tree executes — never live-tree bytes a racing writer
    # could swap mid-install; ROMP_INSTALL_TARGET aims outputs at the real checkout
    _snap = os.path.join(gdir, "romp-install-snap")
    _sh.rmtree(_snap, ignore_errors=True)
    os.makedirs(_snap)
    _a = subprocess.run(["git", "-C", root, "archive", commit], capture_output=True)
    if _a.returncode or not _a.stdout:
        return False
    if subprocess.run(["tar", "-x", "-C", _snap], input=_a.stdout).returncode \
            or not os.path.exists(os.path.join(_snap, "install.sh")):
        _sh.rmtree(_snap, ignore_errors=True)
        return False
    _env = dict(os.environ, ROMP_INSTALL_TARGET=root)
    _sirv = subprocess.run(["git", "-C", root, "rev-parse", commit], capture_output=True, text=True)
    if _sirv.returncode == 0 and len((_sirv.stdout or "").strip()) >= 8:
        _env["ROMP_INSTALL_COMMIT"] = (_sirv.stdout or "").strip()   # the immutable intent (P1.2)
    _rc = subprocess.run(["bash", os.path.join(_snap, "install.sh")], cwd=root, env=_env,
                         pass_fds=(fd,)).returncode
    _sh.rmtree(_snap, ignore_errors=True)
    return _rc == 0
# the heal's generation build is the validated gen_build defined above the marker leg (the
# runtime generation is REQUIRED before this heal spends the latch — the r47 verification)
sys.stderr.write("romp-serve: this checkout's last install never finished — running install.sh before the kernel starts\n")
if not snap_install(cur8):
    sys.exit(70)                       # latch stays armed for the next retry
if not gen_build(cur8):
    sys.stderr.write("romp-serve: healed the install but the runtime generation could not be "
                     "built — the latch stays armed for the next retry\n")
    sys.exit(70)
if not arm_marker(cur8):
    # arm BEFORE the latch is spent, like every other update transaction (the r48
    # verification): without the marker this very boot resolved live bytes on a dirty tree
    sys.stderr.write("romp-serve: healed the install but the update marker could not be armed "
                     "— the latch stays armed for the next retry\n")
    sys.exit(70)
cur_line = next(ln for ln in rawlines if ln.split()[0][:8] == cur8)
if len(cur_line.split()) < 2 and cur_line == rawlines[0] and len(rawlines) > 1 \
        and len(rawlines[1].split()) > 1:
    cur_line = rawlines[1]             # the completing INTENT line inherits the carried choice —
    #                                    but never the reverse (the v1.3.11 audit: this gate
    #                                    erased a carried stable and served under dev)
if not publish_line(cur_line):
    sys.stderr.write("romp-serve: healed the install but its update channel could not be "
                     "recorded — not starting this build under the OLD channel marker\n")
    sys.exit(70)                       # latch stays armed; the next retry publishes
os.remove(latch)                       # healed — spent under the same lock
emit_pick()
sys.exit(0)
GATEPY
then
    echo "romp-serve: install.sh did not pass (or another update holds this checkout's lock, or HEAD is unreadable) --" >&2
    echo "  refusing to start a kernel on a half-installed build; the manager retries with backoff." >&2
    exit 70
fi

# Map onto the kernel's env, then exec it (preserving the PID for the manager).
# ROMP_MANAGER_PID (parent-death watchdog) and ROMP_SERVE_TOKEN (auto-loaded from the
# persisted token file if unset) flow through untouched. ROMP_KERNEL_NO_OPEN keeps a
# supervised kernel from popping a browser on every (re)spawn.
export ROMP_DIR
export ROMP_BIN="${ROMP_BIN:-$ROMP_DIR/bin/romp}"
# Export BOTH spellings from the ONE resolved port, so nothing downstream can read a stale
# inherited copy of the other name: the kernel and the postal bus read ROMP_KERNEL_PORT, while
# the wake hook and any `romp` CLI run inside a session of this kernel may read either. Unset
# stays unset (the kernel applies its own default), so a bare launch is unchanged.
if [[ -n "$port" ]]; then
    export ROMP_KERNEL_PORT="$port"
    export ROMP_SERVE_PORT="$port"
fi
export ROMP_SERVE_HOST="$host"
export ROMP_KERNEL_NO_OPEN=1
# APPLY the gate's pick (the v1.3.21 audit's P1.2): the gate resolved gen-vs-live UNDER the
# update lock — including a generation its own heal or marker leg just built — and wrote it to
# the pick file. The explicit ROMP_KERNEL_BIN seam still wins; an empty pick (the gate exited
# before picking: a non-git checkout) keeps the live default.
if [ -z "${ROMP_KERNEL_BIN:-}" ] && [ -n "${_ROMP_PICK:-}" ]; then
    _PICK="$(head -1 "$_ROMP_PICK" 2>/dev/null || true)"
    case "$_PICK" in
        "gen "*)
            KERNEL="${_PICK#gen }/bin/romp-kernel"
            export ROMP_CHECKOUT="$ROMP_DIR"
            ;;
        live)
            KERNEL="$ROMP_DIR/bin/romp-kernel"
            unset ROMP_CHECKOUT
            ;;
        *)
            # a MISSING or malformed pick after a successful gate is tampering or failure —
            # never the live default (the r50 verification: retaining the default was the
            # fail-open the pick machinery exists to end)
            echo "romp-serve: the gate's launch pick is missing or malformed — refusing" >&2
            exit 70
            ;;
    esac
    rm -f "$_ROMP_PICK"
    # REVALIDATE and EXEC in ONE python, with the update lock HELD THROUGH os.execv (the
    # v1.3.23 audit's P1.1): the previous shape re-took the lock on bash's fd 9, ran the
    # checks, then CLOSED the fd before exec — an update landing in that gap deterministically
    # booted the superseded pick while HEAD and the marker named the new build, and the
    # updater's pkill never saw it (the process was still this bash, not yet a kernel). The
    # launcher's lock fd is CLOEXEC (python fds are non-inheritable by default), so the lock
    # releases exactly as the kernel image replaces the process — never before: an updater can
    # only take the lock once the picked kernel is RUNNING, where its pkill covers it. The
    # earlier "a held flock would ride into the kernel forever" worry is answered by CLOEXEC,
    # not by an early release. The launcher keeps every standing rule: the in-transaction
    # standdown (pid-alive ROMP_INSIDE_UPDATE_TXN — the txn holds this lock across install →
    # manager → serve), the lockless advisory reads for an unopenable lock (read-only git
    # dir), the bounded ROMP_REVAL_LOCK_WAIT sibling wait, and fcntl over any flock(1) binary
    # (absent on stock macOS).
    exec python3 -c '
import fcntl, os, stat, subprocess, sys, time

root, kernel, pick, py = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]

def refuse(msg):
    sys.stderr.write("romp-serve: %s\n" % msg)
    sys.exit(70)

def launch():
    if not os.access(kernel, os.X_OK):
        refuse("kernel not found/executable at %s" % kernel)
    os.execv(py, [py, kernel])

txn = os.environ.get("ROMP_INSIDE_UPDATE_TXN", "")
alive = False
if txn.isdigit() and int(txn) > 0:
    try:
        os.kill(int(txn), 0)
        alive = True
    except OSError:
        pass                        # holder gone: the txn is stale — revalidate normally
if alive:
    launch()                        # the transaction owns the checkout; its verdict governs
gd = subprocess.run(["git", "-C", root, "rev-parse", "--absolute-git-dir"],
                    capture_output=True, text=True)
gdir = (gd.stdout or "").strip()
if gd.returncode or not gdir:
    launch()                        # not a git checkout: no update can move under this boot
fd = None
try:
    fd = os.open(os.path.join(gdir, "romp-update.lock"), os.O_RDWR | os.O_CREAT, 0o644)
except OSError:
    # an UNOPENABLE lock mirrors the gate: a git dir that cannot host the lock cannot host
    # an update either — the checks below still run, locklessly, the same advisory reads
    sys.stderr.write("romp-serve: the update lock is unopenable — revalidating locklessly\n")
if fd is not None:
    try:
        wait = float(os.environ.get("ROMP_REVAL_LOCK_WAIT") or 15.0)
    except ValueError:
        wait = 15.0
    deadline = time.time() + wait
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except OSError:
            if time.time() >= deadline:
                refuse("an update is mid-flight — refusing this stale pick")
            time.sleep(0.2)
hf = subprocess.run(["git", "-C", root, "rev-parse", "HEAD"], capture_output=True, text=True)
head = (hf.stdout or "").strip()
mkp = os.path.join(gdir, "romp-restart-needed")
mtok = ""
try:
    if stat.S_ISREG(os.lstat(mkp).st_mode):   # a FIFO/device must not hang the open
        mfd = os.open(mkp, os.O_RDONLY | getattr(os, "O_NONBLOCK", 0)
                      | getattr(os, "O_NOFOLLOW", 0))
        try:
            raw = os.read(mfd, 4096).decode(errors="replace").split("\n")[0]
        finally:
            os.close(mfd)
        mtok = "".join(c for c in raw if c in "0123456789abcdef")
except FileNotFoundError:
    mtok = ""
except OSError:
    refuse("the update marker is unreadable — refusing (respawn re-picks)")
if pick.startswith("gen "):
    if not head or not pick[len("gen "):].endswith("romp-run-" + head[:8]):
        refuse("HEAD moved past the gate'"'"'s pick — refusing (respawn re-picks)")
elif mtok and head and mtok[:8] == head[:8]:
    refuse("an update marker armed after the gate'"'"'s live pick — refusing (respawn re-picks)")
launch()
' "$ROMP_DIR" "$KERNEL" "$_PICK" "$PY"
fi
[ -n "${_ROMP_PICK:-}" ] && rm -f "$_ROMP_PICK"
[[ -x "$KERNEL" ]] || { echo "romp-serve: kernel not found/executable at $KERNEL" >&2; exit 70; }
exec "$PY" "$KERNEL"
